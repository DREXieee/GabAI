<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- AuthSessionStore.kt persists the Supabase access/refresh tokens in
         plaintext DataStore (datastore/auth_session.preferences_pb). Excluded
         from both cloud backup and device-transfer so a compromised Google
         account backup or device-to-device transfer can't hand over a live
         session for this app. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/auth_session.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/auth_session.preferences_pb" />
    </device-transfer>
</data-extraction-rules>